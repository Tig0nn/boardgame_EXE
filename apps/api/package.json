{
  "name": "@exe/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests drizzle.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --experimental-strip-types --test tests/postgres.integration.ts tests/actions.integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/db/cli.ts migrate",
    "db:check": "node --env-file-if-exists=.env --experimental-strip-types src/db/cli.ts check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
