# Public client configuration. Never include personal/admin tokens or server secrets.
EXPO_PUBLIC_EXE_API_ORIGIN=https://exe-staging-backend.onrender.com
EXPO_PUBLIC_SUPABASE_URL=https://yqikecqeijeaygmmjdyg.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_EXE_WHATIF_GEMINI=0

# Optional public PostHog capture project key (phc_), not a personal API token.
# Empty configuration means no analytics SDK initialization or requests.
EXPO_PUBLIC_EXE_POSTHOG_KEY=
# Choose exactly https://us.i.posthog.com or https://eu.i.posthog.com
EXPO_PUBLIC_EXE_POSTHOG_HOST=
# Default 1 = QA. Set 0 only for a consenting friends/tester build.
EXPO_PUBLIC_EXE_ANALYTICS_TEST_MODE=1
