{
  "expo": {
    "name": "EXE · Mỏ Hỗn",
    "slug": "exe-boardgame-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "exe-boardgame",
    "android": {
      "package": "vn.exe.boardgame.nativeapp",
      "versionCode": 9,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#214237"
      }
    },
    "ios": {
      "bundleIdentifier": "vn.exe.boardgame.nativeapp",
      "supportsTablet": true
    },
    "plugins": [
      "./plugins/with-beta-release.cjs",
      "expo-secure-store",
      "expo-dev-client",
      "expo-image",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-localization"
    ],
    "icon": "../public/assets/cropped/app-logo.png"
  }
}
